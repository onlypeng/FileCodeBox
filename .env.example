# FileCodeBox 环境变量示例
# 复制为 .env 并按需修改；docker compose 会自动读取同目录 .env 文件。
#
# 生成强随机值的命令：
#   openssl rand -hex 32

# ===== 安全（强烈建议生产环境设置） =====
# JWT 签名密钥：用于管理后台 Token 签名。
# 未设置时回退到管理员口令派生（修改管理员密码会导致已签发 Token 失效，且弱口令即弱密钥）。
JWT_SECRET=

# 敏感配置加密密钥：用于加密存储 S3/WebDAV/OneDrive 等凭据（Fernet，32 字节 urlsafe base64）。
# 未设置时从管理员口令派生（修改管理员密码将导致存量密文无法解密）。
ENCRYPTION_KEY=

# ===== 服务 =====
# 监听地址与端口
# HOST=0.0.0.0
# PORT=12345
# 工作进程数（多进程需保证数据库为 WAL 且共享同一 data 目录）
# WORKERS=1
# 日志级别（debug/info/warning/error）
# LOG_LEVEL=info

# ===== 首次部署必做 =====
# 1. 启动后访问 /admin 登录后台
# 2. 立即在"系统设置"中修改默认管理员口令（默认值为 FileCodeBox2023，必须修改）
